{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Bash(*)"],
    "ask": [
      "Bash(kubectl get secret*)",
      "Bash(kubectl get secrets*)",
      "Bash(kubectl describe secret*)"
    ],
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin --delete main*)",
      "Bash(git push --delete main*)",
      "Bash(git branch -D main*)",
      "Bash(git branch -d main*)",
      "Read(./kubeconfig)",
      "Read(./talosconfig)",
      "Read(./age.key)",
      "Read(./.secrets.env)",
      "Read(./.decrypted~*)",
      "mcp__ToolHive__context7_*"
    ]
  },
  "agent": "homelab-k8s",
  "enabledMcpjsonServers": ["ToolHive", "context7", "dashboard-icons"]
}
