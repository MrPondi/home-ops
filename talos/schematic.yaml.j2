---
customization:
  extraKernelArgs:
    - amd_iommu=on                        # PCI Passthrough
    - iommu=pt                            # PCI Passthrough
    - pcie_aspm=off                       # Disable PCIe ASPM
    - pcie_port_pm=off                    # Disable PCIe Port PM
    - i915.force_probe=56a6               # Intel GPU (i915) Force Probe
    - -selinux                            # Disable SELinux (removes the default selinux=1)
    - audit=0                             # Disable kernel audit
    - selinux=0                           # Disable SELinux
    - talos.auditd.disabled=1             # Disable Talos auditd (pair with audit=0)
  systemExtensions:
    officialExtensions:
      - siderolabs/amd-ucode              # AMD CPU Microcode
      - siderolabs/amdgpu                 # AMD GPU
      - siderolabs/drbd                   # Miroir DRBD9 Replication
      - siderolabs/gvisor                 # gVisor sandbox runtime (kritika runners)
      - siderolabs/i915                   # Intel GPU
      - siderolabs/iscsi-tools            # Longhorn
      - siderolabs/mei                    # Intel GPU
      - siderolabs/nfsrahead              # NFS Readahead
      - siderolabs/util-linux-tools       # Longhorn
      - siderolabs/qemu-guest-agent       # Guest Agent
