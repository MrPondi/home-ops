---
version: v1alpha1
machine:
  ca:
    crt: ref+bw://aed953fc-ef3c-4fd2-8bf6-b46600d71db3/notes#/machine_ca_crt
  features:
    apidCheckExtKeyUsage: true
    diskQuotaSupport: true
    rbac: true
  token: ref+bw://aed953fc-ef3c-4fd2-8bf6-b46600d71db3/notes#/machine_token
cluster:
  ca:
    crt: ref+bw://aed953fc-ef3c-4fd2-8bf6-b46600d71db3/notes#/cluster_ca_crt
  clusterName: main
  controlPlane:
    endpoint: https://k8s.internal:6443
  token: ref+bw://aed953fc-ef3c-4fd2-8bf6-b46600d71db3/notes#/cluster_token
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: ethSel0
clientIdentifier: mac
---
apiVersion: v1alpha1
kind: LinkConfig
name: ethSel0
mtu: 1500
---
apiVersion: v1alpha1
kind: LinkConfig
name: ethSel1
mtu: 1500
---
apiVersion: v1alpha1
kind: LinkConfig
name: ethSel2
mtu: 1500
---
apiVersion: v1alpha1
kind: ResolverConfig
searchDomains:
  domains: []
hostDNS:
  enabled: true
  forwardKubeDNSToHost: true # Requires Cilium socketLB features
  resolveMemberNames: true
---
apiVersion: v1alpha1
kind: DiscoveryServiceConfig
name: default
endpoint: https://discovery.talos.dev/
---
apiVersion: v1alpha1
kind: DiscoveryIdentityConfig
clusterID: ref+bw://aed953fc-ef3c-4fd2-8bf6-b46600d71db3/notes#/cluster_id
clusterSecret: ref+bw://aed953fc-ef3c-4fd2-8bf6-b46600d71db3/notes#/cluster_secret
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: factory.talos.dev/nocloud-installer/{{ schematic }}:v1.14.0
provisioning:
  diskSelector:
    match: disk.dev_path == '/dev/sda'
  wipe: false
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: longhorn-storage
volumeType: disk
provisioning:
  diskSelector:
    match: disk.dev_path == '/dev/sdc' && disk.model == "QEMU HARDDISK"
filesystem:
  type: xfs
---
apiVersion: v1alpha1
kind: RawVolumeConfig
name: miroir-slow
provisioning:
  diskSelector:
    match: disk.dev_path == '/dev/sdb' && disk.model == "QEMU HARDDISK" && !system_disk
  minSize: 150GB
  maxSize: 200GB
---
apiVersion: v1alpha1
kind: FilesystemTrimConfig
interval: 168h0m0s
---
apiVersion: v1alpha1
kind: FilesystemScrubConfig
interval: 168h0m0s
---
apiVersion: v1alpha1
kind: WatchdogTimerConfig
device: /dev/watchdog0
timeout: 5m
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: dm_thin_pool
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: drbd
parameters:
  - usermode_helper=disabled
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: drbd_transport_tcp
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nbd
---
apiVersion: v1alpha1
kind: SysctlConfig
params:
  fs.inotify.max_user_instances: 8192      # Watchdog
  fs.inotify.max_user_watches: 1048576     # Watchdog
  net.core.default_qdisc: fq               # 10Gb/s
  net.core.netdev_max_backlog: 50000       # 10Gb/s
  net.core.somaxconn: 65535                # 10Gb/s
  net.core.rmem_max: 67108864              # 10Gb/s | Cloudflared / QUIC
  net.core.wmem_max: 67108864              # 10Gb/s | Cloudflared / QUIC
  net.ipv4.ip_local_port_range: 1024 65535 # Increase port ranges
  net.ipv4.ping_group_range: 0 2147483647  # Ping non-root
  net.ipv4.tcp_congestion_control: bbr     # 10Gb/s
  net.ipv4.tcp_fastopen: 3                 # Send and accept data in the opening SYN packet
  net.ipv4.neigh.default.gc_thresh1: 4096
  net.ipv4.neigh.default.gc_thresh2: 8192
  net.ipv4.neigh.default.gc_thresh3: 16384
  net.ipv4.tcp_mtu_probing: 1              # 10Gb/s | Jumbo frames
  net.ipv4.tcp_notsent_lowat: 131072       # 10Gb/s
  net.ipv4.tcp_slow_start_after_idle: 0    # 10Gb/s
  net.ipv4.tcp_tw_reuse: 1                 # Reuse sockets in TIME_WAIT
  net.ipv4.tcp_rmem: 4096 131072 67108864  # 10Gb/s
  net.ipv4.tcp_wmem: 4096 16384 67108864   # 10Gb/s
  user.max_user_namespaces: 11255
  vm.nr_hugepages: 1024                    # Longhorn
---
apiVersion: v1alpha1
kind: EtcFileConfig
name: nfsmount.conf
mode: 0o644
contents: |
  [ NFSMount_Global_Options ]
  nfsvers=4.2
  hard=True
  nconnect=16
  noatime=True
  rsize=1048576
  wsize=1048576
---
apiVersion: v1alpha1
kind: CRICustomizationConfig
name: containerd
content: |
  [plugins."io.containerd.cri.v1.images"]
    discard_unpacked_layers = false
  [plugins."io.containerd.cri.v1.runtime"]
    device_ownership_from_security_context = true
---
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeIP:
  validSubnets:
    - 10.0.30.0/24
labels:
  node.kubernetes.io/gpu: "true"
  topology.kubernetes.io/region: main
---
apiVersion: v1alpha1
kind: KubeletConfig
config:
  maxPods: 240
  crashLoopBackOff:
    maxContainerRestartPeriod: 60s
  imageMaximumGCAge: 168h
  maxParallelImagePulls: 3
  serializeImagePulls: false
  shutdownGracePeriod: 90s
  shutdownGracePeriodCriticalPods: 60s
defaultRuntimeSeccompProfileEnabled: true
image: ghcr.io/siderolabs/kubelet:v1.37.0
---
apiVersion: v1alpha1
kind: KubeNetworkConfig
dnsDomain: cluster.local
podSubnets:
  - 10.42.0.0/16
serviceSubnets:
  - 10.43.0.0/16
---
apiVersion: v1alpha1
kind: KubePrismConfig
port: 7445
