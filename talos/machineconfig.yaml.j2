---
version: v1alpha1
machine:
  ca:
    crt: ref+bw://aed953fc-ef3c-4fd2-8bf6-b46600d71db3/notes#/machine_ca_crt
    {% if ENV.CONTROLPLANE %}
    key: ref+bw://aed953fc-ef3c-4fd2-8bf6-b46600d71db3/notes#/machine_ca_key
    {% endif %}
  features:
    apidCheckExtKeyUsage: true
    diskQuotaSupport: true
    hostDNS:
      enabled: true
      forwardKubeDNSToHost: true # Requires Cilium socketLB features
      resolveMemberNames: true
    kubePrism:
      enabled: true
      port: 7445
    {% if ENV.CONTROLPLANE %}
    kubernetesTalosAPIAccess:
      enabled: true
      allowedKubernetesNamespaces:
        - actions-runner-system
        - system-upgrade
      allowedRoles:
        - os:admin
    {% endif %}
    rbac: true
  files:
    - op: create
      path: /etc/cri/conf.d/20-customization.part
      content: |
        [plugins."io.containerd.cri.v1.images"]
          discard_unpacked_layers = false
        [plugins."io.containerd.cri.v1.runtime"]
          device_ownership_from_security_context = true
    - op: overwrite
      path: /etc/nfsmount.conf
      permissions: 0o644
      content: |
        [ NFSMount_Global_Options ]
        nfsvers=4.2
        hard=True
        nconnect=8
        noatime=True
        rsize=1048576
        wsize=1048576
  install:
    disk: /dev/sda
    image: factory.talos.dev/installer/{{ ENV.SCHEMATIC }}:v1.13.4
    wipe: false
  kubelet:
    defaultRuntimeSeccompProfileEnabled: true
    disableManifestsDirectory: true
    extraConfig:
      imageGCHighThresholdPercent: 65
      imageGCLowThresholdPercent: 60
      maxPods: 240
      serializeImagePulls: false
    image: ghcr.io/siderolabs/kubelet:v1.36.1
    nodeIP:
      validSubnets:
        - 10.0.30.0/24
  nodeLabels:
    node.kubernetes.io/gpu: "true"
    topology.kubernetes.io/region: main
  sysctls:
    fs.inotify.max_user_instances: "8192"
    fs.inotify.max_user_watches: "1048576"
    net.core.default_qdisc: fq
    net.core.rmem_max: "67108864"
    net.core.wmem_max: "67108864"
    net.ipv4.neigh.default.gc_thresh1: "4096"
    net.ipv4.neigh.default.gc_thresh2: "8192"
    net.ipv4.neigh.default.gc_thresh3: "16384"
    net.ipv4.ping_group_range: 0 2147483647
    net.ipv4.tcp_congestion_control: bbr
    net.ipv4.tcp_fastopen: "3"
    net.ipv4.tcp_mtu_probing: "1"
    net.ipv4.tcp_notsent_lowat: "131072"
    net.ipv4.tcp_rmem: 4096 87380 33554432
    net.ipv4.tcp_slow_start_after_idle: "0"
    net.ipv4.tcp_window_scaling: "1"
    net.ipv4.tcp_wmem: 4096 65536 33554432
    sunrpc.tcp_max_slot_table_entries: "128"
    sunrpc.tcp_slot_table_entries: "128"
    user.max_user_namespaces: "11255"
    vm.nr_hugepages: "1024"
  token: ref+bw://aed953fc-ef3c-4fd2-8bf6-b46600d71db3/notes#/machine_token
cluster:
  ca:
    crt: ref+bw://aed953fc-ef3c-4fd2-8bf6-b46600d71db3/notes#/cluster_ca_crt
    {% if ENV.CONTROLPLANE %}
    key: ref+bw://aed953fc-ef3c-4fd2-8bf6-b46600d71db3/notes#/cluster_ca_key
    {% endif %}
  clusterName: main
  controlPlane:
    endpoint: https://k8s.internal:6443
  discovery:
    enabled: true
    registries:
      kubernetes:
        disabled: true
      service:
        disabled: false
  id: ref+bw://aed953fc-ef3c-4fd2-8bf6-b46600d71db3/notes#/cluster_id
  network:
    cni:
      name: none
    dnsDomain: cluster.local
    podSubnets:
      - 10.42.0.0/16
    serviceSubnets:
      - 10.43.0.0/16
  secret: ref+bw://aed953fc-ef3c-4fd2-8bf6-b46600d71db3/notes#/cluster_secret
  token: ref+bw://aed953fc-ef3c-4fd2-8bf6-b46600d71db3/notes#/cluster_token
  {% if ENV.CONTROLPLANE %}
  aggregatorCA:
    crt: ref+bw://aed953fc-ef3c-4fd2-8bf6-b46600d71db3/notes#/cluster_aggregatorca_crt
    key: ref+bw://aed953fc-ef3c-4fd2-8bf6-b46600d71db3/notes#/cluster_aggregatorca_key
  allowSchedulingOnControlPlanes: true
  apiServer:
    auditPolicy:
      apiVersion: audit.k8s.io/v1
      kind: Policy
      rules:
        - level: Metadata
    certSANs:
      - k8s.internal
    disablePodSecurityPolicy: true
    extraArgs:
      enable-aggregator-routing: "true"
      feature-gates: HPAScaleToZero=true
    image: registry.k8s.io/kube-apiserver:v1.36.1
  controllerManager:
    extraArgs:
      bind-address: 0.0.0.0
      feature-gates: HPAScaleToZero=true
    image: registry.k8s.io/kube-controller-manager:v1.36.1
  coreDNS:
    disabled: true
  etcd:
    advertisedSubnets:
      - 10.0.30.0/24
    ca:
      crt: ref+bw://aed953fc-ef3c-4fd2-8bf6-b46600d71db3/notes#/cluster_etcd_ca_crt
      key: ref+bw://aed953fc-ef3c-4fd2-8bf6-b46600d71db3/notes#/cluster_etcd_ca_key
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
  proxy:
    disabled: true
    image: registry.k8s.io/kube-proxy:v1.36.1
  scheduler:
    config:
      apiVersion: kubescheduler.config.k8s.io/v1
      kind: KubeSchedulerConfiguration
      profiles:
        - schedulerName: default-scheduler
          plugins:
            score:
              disabled:
                - name: ImageLocality
          pluginConfig:
            - name: PodTopologySpread
              args:
                defaultingType: List
                defaultConstraints:
                  - maxSkew: 1
                    topologyKey: kubernetes.io/hostname
                    whenUnsatisfiable: ScheduleAnyway
    extraArgs:
      bind-address: 0.0.0.0
    image: registry.k8s.io/kube-scheduler:v1.36.1
  secretboxEncryptionSecret: ref+bw://aed953fc-ef3c-4fd2-8bf6-b46600d71db3/notes#/cluster_secretboxencryptionsecret
  serviceAccount:
    key: ref+bw://3c2a7ca7-323e-4c05-aa4e-b46600d6f8fa/notes
  {% endif %}
---
apiVersion: v1alpha1
kind: LinkConfig
name: ethSel0
mtu: 1500
---
apiVersion: v1alpha1
kind: LinkConfig
name: ethSel1
mtu: 1500
---
apiVersion: v1alpha1
kind: LinkConfig
name: ethSel2
mtu: 1500
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: ethSel0
---
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: 10.0.30.10
link: ethSel0
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: longhorn-storage
volumeType: disk
provisioning:
  diskSelector:
    match: disk.dev_path == '/dev/sdb'
filesystem:
  type: xfs
---
apiVersion: v1alpha1
kind: WatchdogTimerConfig
device: /dev/watchdog0
timeout: 5m