{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#11.0.0",
    "github>home-operations/renovate-presets//apps/cnpg.json5#11.0.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#11.0.0",
    "github>home-operations/renovate-presets//apps/searxng.json5#11.0.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#11.0.0",
    ":timezone(Europe/Warsaw)",
  ],
  // Automerge = label hand-off to .github/workflows/renovate-automerge.yaml (overrides the
  // preset's :automergeBranch); Renovate never merges or enables platform auto-merge itself
  automergeType: "label",
  // Requested at creation on non-automerge PRs, and on automerge PRs once a check fails
  reviewers: ["@MrPondi"],
  // The Main ruleset does not require up-to-date branches, and `auto` would
  // still rebase every automerge PR each time main moves
  rebaseWhen: "conflicted",
  packageRules: [
    // Auto-merge rules: Renovate only adds the `automerge` label once every check is green; the
    // renovate-automerge workflow merges when kritika approved the head SHA, otherwise it requests
    // a review. Never use automergeType pr/branch or ignoreTests here: they bypass kritika.
    {
      description: "Auto-merge patch and digest updates (gated by kritika approval)",
      matchUpdateTypes: ["patch", "digest"],
      automerge: true,
    },
    {
      description: "Auto-merge minor updates of stable (>=1.0) versions (gated by kritika approval)",
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "!/^v?0\\./",
      automerge: true,
    },
    {
      description: "Never auto-merge major updates",
      matchUpdateTypes: ["major"],
      automerge: false,
    },
    // Scheduling rules
    {
      description: "Let GitHub Actions releases settle",
      matchManagers: ["github-actions"],
      minimumReleaseAge: "3 days",
    },
    {
      description: "Trusted GitHub Actions need no settling time",
      matchManagers: ["github-actions"],
      matchPackageNames: ["/^actions\\//", "/^renovatebot\\//"],
      minimumReleaseAge: "1 minute",
    },
    {
      description: "Batch high-cadence OCI packages weekly",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/kube-prometheus-stack/"],
      schedule: ["before 6am on Monday"],
    },
    // Grouping rules
    {
      description: "Actions Runner Controller Group",
      groupName: "actions-runner-controller",
      matchDatasources: ["docker"],
      matchPackageNames: ["/gha-runner-scale-set-controller/", "/gha-runner-scale-set/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 3,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 5,
      separateMinorPatch: true,
    },
    {
      description: "Mise Tools Group",
      matchManagers: ["mise"],
      groupName: "mise tools",
      groupSlug: "mise-tools",
    },
    {
      // Unites the factory installer image, the tuppr upgrade version and the etcd-defrag talosctl image
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos", "ghcr.io/siderolabs/talosctl"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "ToolHive Operator Group",
      groupName: "toolhive-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/toolhive-operator/", "/toolhive-operator-crds/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Keep CloudNativePG on Postgres 18 until the extension images move with it",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      allowedVersions: "/^18\\./",
    },
    // Labeling rules
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
  ],
}
