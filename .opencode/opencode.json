{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "homelab-k8s",
  "tools": {
    "ToolHive_context7_*": false,
    "ToolHive_flux_*": false,
    "ToolHive_github_*": false,
    "ToolHive_grafana_*": false,
    "ToolHive_hass_*": false,
    "ToolHive_kubernetes_*": false,
    "ToolHive_prometheus_*": false,
    "ToolHive_seerr_*": false,
    "ToolHive_servarr_*": false,
    "ToolHive_talos_*": false,
    "ToolHive_unifi-network_*": false,
    "ToolHive_victoria-logs_*": false,
    "ToolHive_webfetch": false,
    "ToolHive_websearch": false
  },
  "mcp": {
    "ToolHive": {
      "type": "remote",
      "url": "https://mcp.pondi.dev/mcp",
      "enabled": true,
      "oauth": {}
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    }
  },
  "lsp": {
    "yaml-ls": { "disabled": true },
    "yayamlls": {
      "command": ["yayamlls"],
      "extensions": [".yaml", ".yml"]
    }
  }
}
