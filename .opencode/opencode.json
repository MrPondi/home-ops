{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "homelab-k8s",
  "mcp": {
    "ToolHive": {
      "type": "remote",
      "url": "https://mcp.pondi.dev/mcp",
      "enabled": true,
      "oauth": {}
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    }
  },
  "lsp": {
    "yaml-ls": { "disabled": true },
    "yayamlls": {
      "command": ["yayamlls"],
      "extensions": [".yaml", ".yml"]
    }
  }
}
