{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "homelab-k8s",
  "tools": {
    "ToolHive_context7_*": false
  },
  "mcp": {
    "ToolHive": {
      "type": "remote",
      "url": "https://mcp.pondi.dev/mcp",
      "enabled": true,
      "oauth": {}
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "terraform": {
      "type": "local",
      "command": ["docker", "run", "-i", "--rm", "hashicorp/terraform-mcp-server:1.3.0"],
      "enabled": true
    }
  },
  "lsp": {
    "yaml-ls": { "disabled": true },
    "yayamlls": {
      "command": ["yayamlls"],
      "extensions": [".yaml", ".yml"]
    }
  }
}
