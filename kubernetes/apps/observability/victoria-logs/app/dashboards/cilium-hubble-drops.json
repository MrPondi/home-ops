{
  "title": "Cilium Hubble Policy Drops",
  "uid": "cilium-hubble-drops",
  "tags": ["cilium", "hubble", "logs"],
  "schemaVersion": 41,
  "editable": true,
  "graphTooltip": 1,
  "preload": false,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Dropped flows by source namespace",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "${DS_VICTORIALOGS}" },
      "targets": [
        {
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "${DS_VICTORIALOGS}" },
          "refId": "A",
          "queryType": "range",
          "expr": "{log_source=\"cilium-hubble\"} | flow.verdict:=\"DROPPED\" | stats by ($__interval (_time), flow.source.namespace) count() as drops"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 35,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": { "mode": "normal" }
          },
          "unit": "short",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 2,
      "title": "Dropped flows by destination namespace",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "${DS_VICTORIALOGS}" },
      "targets": [
        {
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "${DS_VICTORIALOGS}" },
          "refId": "A",
          "queryType": "range",
          "expr": "{log_source=\"cilium-hubble\"} | flow.verdict:=\"DROPPED\" | stats by ($__interval (_time), flow.destination.namespace) count() as drops"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 35,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": { "mode": "normal" }
          },
          "unit": "short",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 3,
      "title": "Top dropped destination ports",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "${DS_VICTORIALOGS}" },
      "targets": [
        {
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "${DS_VICTORIALOGS}" },
          "refId": "A",
          "queryType": "raw",
          "expr": "{log_source=\"cilium-hubble\"} | flow.verdict:=\"DROPPED\" | stats by (flow.destination.namespace, flow.l4.TCP.destination_port) count() as drops | sort by (drops) desc | limit 10"
        }
      ],
      "options": { "showHeader": true, "cellHeight": "sm" }
    },
    {
      "id": 4,
      "title": "Top source pods with drops",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "${DS_VICTORIALOGS}" },
      "targets": [
        {
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "${DS_VICTORIALOGS}" },
          "refId": "A",
          "queryType": "raw",
          "expr": "{log_source=\"cilium-hubble\"} | flow.verdict:=\"DROPPED\" | stats by (flow.source.namespace, flow.source.pod_name) count() as drops | sort by (drops) desc | limit 10"
        }
      ],
      "options": { "showHeader": true, "cellHeight": "sm" }
    },
    {
      "id": 5,
      "title": "Recent dropped flows",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "${DS_VICTORIALOGS}" },
      "targets": [
        {
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "${DS_VICTORIALOGS}" },
          "refId": "A",
          "queryType": "raw",
          "expr": "{log_source=\"cilium-hubble\"} | flow.verdict:=\"DROPPED\" | keep _time, _stream, flow.source.namespace, flow.source.pod_name, flow.destination.namespace, flow.destination.pod_name, flow.IP.source, flow.IP.destination, flow.l4.TCP.destination_port, flow.udp.destination_port, flow.l4.UDP.destination_port, flow.drop_reason_desc, flow.l7.dns.query | sort by (_time) desc | limit 100"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      }
    }
  ]
}
